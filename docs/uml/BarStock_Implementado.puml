@startuml StateImplementado
title State - Comanda (model/comanda/state)

class Comanda {
  -estado: EstadoComanda
  +preparar(ahora)
  +despachar(ahora)
  +anular(motivo, ahora)
  +accionesPermitidas(): Set<AccionComanda>
  +setEstado(EstadoComanda)
}
interface EstadoComanda {
  +codigo(): String
  +accionesPermitidas(): Set<AccionComanda>
  +preparar(Comanda, Instant)
  +despachar(Comanda, Instant)
  +anular(Comanda, String, Instant)
}
note right of EstadoComanda : Por defecto cada método lanza\nTransicionInvalidaException (409)
class Registrada
class EnPreparacion
class Despachada
class Anulada
class EstadoComandaConverter <<JPA>>

Comanda --> EstadoComanda
EstadoComanda <|.. Registrada
EstadoComanda <|.. EnPreparacion
EstadoComanda <|.. Despachada
EstadoComanda <|.. Anulada
Registrada --> EnPreparacion : preparar()
Registrada --> Anulada : anular()
EnPreparacion --> Despachada : despachar()
EnPreparacion --> Anulada : anular() [fallida]
Despachada --> Anulada : anular() [devolución, sin reponer stock]
EstadoComandaConverter ..> EstadoComanda
@enduml


@startuml StrategyImplementado
title Strategy - Precios (model/precio)

interface EstrategiaPrecio {
  +codigo(): String
  +nombre(): String
  +calcularPrecio(Receta): BigDecimal
}
class PrecioNormal
class PrecioHappyHour {
  -descuento: BigDecimal
  -margenMinimo: BigDecimal
}
class PrecioDemandaAlta {
  -incremento: BigDecimal
}
class SelectorEstrategiaPrecio {
  -reloj: Clock
  +vigente(Establecimiento, comandasEnCurso): EstrategiaVigente
  +todas(Establecimiento): List<EstrategiaPrecio>
}
class PoliticaPrecio <<Embeddable>> {
  -modo: ModoPrecio
  -horaSimulada: LocalTime
}
class Comanda
class Carta

EstrategiaPrecio <|.. PrecioNormal
EstrategiaPrecio <|.. PrecioHappyHour
EstrategiaPrecio <|.. PrecioDemandaAlta
SelectorEstrategiaPrecio ..> PoliticaPrecio
SelectorEstrategiaPrecio ..> EstrategiaPrecio : crea
Comanda ..> EstrategiaPrecio : fija el precio al registrar
Carta ..> EstrategiaPrecio
@enduml


@startuml ObserverFactoryImplementado
title Observer + Simple Factory - Alertas de stock

class Inventario {
  -observadores: List<ObservadorStock>
  +descontarTodo(List<Consumo>)
  +registrarCompra()
  +ajustarARecuento()
  +agregarObservador()
  +quitarObservador()
  -notificar(eventos) <<after commit>>
}
interface ObservadorStock {
  +actualizar(EventoStock)
}
class AlertaStock
class BitacoraStock
class EventoStock <<record>> {
  +cruzoPuntoDeReposicion(): boolean
}
class NotificacionFactory {
  +crear(TipoNotificacion): Notificacion
}
interface Notificacion {
  +enviar(MensajeAlerta)
}
class NotificacionPanel
class NotificacionEmail
class NotificacionSms
class NotificacionWhatsApp
enum TipoNotificacion {
  PANEL
  EMAIL
  SMS
  WHATSAPP
}

Inventario --> ObservadorStock
ObservadorStock <|.. AlertaStock
ObservadorStock <|.. BitacoraStock
Inventario ..> EventoStock
AlertaStock --> NotificacionFactory
NotificacionFactory ..> Notificacion : crea
NotificacionFactory --> TipoNotificacion
Notificacion <|.. NotificacionPanel
Notificacion <|.. NotificacionEmail
Notificacion <|.. NotificacionSms
Notificacion <|.. NotificacionWhatsApp
@enduml


@startuml DecoratorImplementado
title Decorator - Reportes (model/reporte)

interface Reporte {
  +generar(): ContenidoReporte
}
class ReporteBase
abstract class ReporteDecorator {
  #reporte: Reporte
  +generar(): ContenidoReporte
  #seccion(): SeccionReporte
}
class ReporteConGrafico
class ReporteConTendencias
class ReporteConMermas
class ReporteConMargen
enum TipoSeccion {
  GRAFICO
  TENDENCIAS
  MERMAS
  MARGEN
  +decorar(Reporte, DatosReporte): Reporte
}
interface FuenteDatosReporte
class FuenteDatosReporteJpa
class GeneradorReportes

Reporte <|.. ReporteBase
Reporte <|.. ReporteDecorator
ReporteDecorator o-- Reporte
ReporteDecorator <|-- ReporteConGrafico
ReporteDecorator <|-- ReporteConTendencias
ReporteDecorator <|-- ReporteConMermas
ReporteDecorator <|-- ReporteConMargen
GeneradorReportes ..> TipoSeccion
GeneradorReportes --> FuenteDatosReporte
FuenteDatosReporte <|.. FuenteDatosReporteJpa
@enduml
